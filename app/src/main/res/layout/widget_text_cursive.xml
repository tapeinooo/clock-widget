<?xml version="1.0" encoding="utf-8"?>
<!-- 端末のフォント用：時刻と日付はホーム画面が自分で進める（TextClock）。フォントごとに1つ（後から変えられないため） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <!-- 文字の大きさを手で決めるとき -->
    <LinearLayout
        android:id="@+id/manual"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextClock
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="cursive"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="36sp" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="cursive"
            android:format12Hour="M月d日(E)"
            android:format24Hour="M月d日(E)"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 大きさに合わせるとき：高さを字の高さに合わせ、字の上の空きの分だけ上にずらして置く（ClockWidget.kt） -->
    <FrameLayout
        android:id="@+id/fit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone">

        <TextClock
            android:id="@+id/fit_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginBottom="-2000dp"
            android:fontFamily="cursive"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="36sp" />

        <TextClock
            android:id="@+id/fit_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginBottom="-2000dp"
            android:fontFamily="cursive"
            android:format12Hour="M月d日(E)"
            android:format24Hour="M月d日(E)"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </FrameLayout>
</FrameLayout>
